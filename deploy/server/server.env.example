# Copy to deploy/server/server.env (gitignored) — init-env.sh does this for you.
# Values here are read by prom.sh and interpolated into the *.override.yml files.

# Public names (A records -> 118.174.9.188). Covered by the *.ntaisolution.com wildcard cert.
PROM_DOMAIN=prom.ntaisolution.com
PROM_HUB_DOMAIN=prom-hub.ntaisolution.com

# Host ports, bound to 127.0.0.1 only. The host nginx is the only public entry point.
# Checked free on adminmc 2026-11-05.
PROM_PLANE_HTTP_PORT=8180
PROM_HUB_HTTP_PORT=8001

# Hub's own Postgres password (only used inside the prom-hub compose network).
HUB_DB_PASSWORD=change-me

# Satisfies interpolation in plane/docker-compose.yml; the override replaces the real port list.
LISTEN_HTTP_PORT=8180
LISTEN_HTTPS_PORT=8543
