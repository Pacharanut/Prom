# Copy to deploy/server/server.env (gitignored); init-env.sh does this for you.
# Edit it BEFORE running init-env.sh the second time: the domains end up in the other env files.

# ngrok  = test mode: one ngrok URL serves Plane and Hub (prom.sh edge up -d), no DNS needed.
# domain = real subdomains through the host nginx (README step 6).
PROM_MODE=ngrok

# --- ngrok mode ---------------------------------------------------------------------------
# From https://dashboard.ngrok.com: "Your Authtoken" and "Domains" (the free static domain).
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-name.ngrok-free.app

# Public names. ngrok mode: set BOTH to the NGROK_DOMAIN value.
# domain mode: prom.ntaisolution.com / prom-hub.ntaisolution.com (A records -> 118.174.9.188).
PROM_DOMAIN=your-name.ngrok-free.app
PROM_HUB_DOMAIN=your-name.ngrok-free.app

# Host ports, bound to 127.0.0.1 only. Checked free on adminmc 2026-11-05.
PROM_PLANE_HTTP_PORT=8180
PROM_HUB_HTTP_PORT=8001

# Hub's own Postgres password (only used inside the prom-hub compose network).
HUB_DB_PASSWORD=change-me

# Satisfies interpolation in plane/docker-compose.yml; the override replaces the real port list.
LISTEN_HTTP_PORT=8180
LISTEN_HTTPS_PORT=8543
