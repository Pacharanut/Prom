# Rendered by the nginx image's envsubst step (only ${PROM_*} variables are replaced).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 127.0.0.1:8280;
    client_max_body_size 10m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    # LINE and Plane webhooks -> Hub (each has its own HMAC signature check).
    location /webhooks/ {
        proxy_pass http://127.0.0.1:${PROM_HUB_HTTP_PORT};
    }

    # Everything else -> Plane (Caddy inside prom-plane-proxy).
    location / {
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_pass http://127.0.0.1:${PROM_PLANE_HTTP_PORT};
    }
}
