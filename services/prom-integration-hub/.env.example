# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=local
LOG_LEVEL=INFO

# These localhost URLs are for running api/worker/beat/discord-bot natively on the host (see
# README's "Run" section), connecting to Dockerized Postgres/Redis via their published host
# ports. Running the full stack via `docker compose up` instead uses service-name URLs, set as
# environment overrides in deployments/docker-compose.yml, not these.
DATABASE_URL=postgresql+asyncpg://prom:prom@localhost:55432/prom_hub
# Port 6380, not the default 6379 — Plane's own docker-compose-local.yml already uses 6379.
REDIS_URL=redis://localhost:6380/0

CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# Plane's own Django api. If Hub runs natively on this host and Plane's api is also native (or
# Dockerized with its port published, per docker-compose-local.yml), localhost:8000 is correct.
# If Hub itself runs via `docker compose up`, localhost inside Hub's containers won't reach a
# host-run Plane -- use http://host.docker.internal:8000 instead (works out of the box in Docker
# Desktop for Mac/Windows).
PROM_API_BASE_URL=http://localhost:8000

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

# Shared secret required on the X-Hub-Service-Token header for every /api/v1/* route. Generate
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HUB_SERVICE_TOKEN=change-me-generate-a-real-service-token

# Externally-reachable base URL of this Hub deployment (Gate 7) — used only to compute the
# webhook_url shown to an admin (what to paste into Plane's own Webhook settings page). Not
# security-sensitive. Port 8001, not the default 8000 — Plane's own docker-compose-local.yml
# already uses 8000 for its Django api container.
HUB_PUBLIC_BASE_URL=http://localhost:8001

# AI assistant (Phase 2) — defaults for a customer that hasn't saved settings yet in Plane's
# Settings → AI Assistant page (that page overrides all of these, and stores its own key
# encrypted). NT_AI_HUB_BASE_URL is the API root, not the web dashboard — for NT AI Hub it ends
# in /core-api/v1.
AI_ENABLED=false
NT_AI_HUB_BASE_URL=https://aihub.ntaisolution.com/core-api/v1
NT_AI_HUB_KEY=
NT_AI_HUB_MODEL=gpt-oss-120b
AI_TIMEOUT_SECONDS=15
